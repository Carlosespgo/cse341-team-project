<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    <label for="region-filter">Search by Region:</label>
    <select id="region-filter">
        <option value="all">All Regions</option>
    </select>

    <label for="season-filter">Search by Season:</label>
    <select id="season-filter">
        <option value="all">Any Season</option>
    </select>
</div>

<p id="trip-status" role="status">Loading trips...</p>
<div class="routes-grid" id="trip-list"></div>

<template id="trip-card-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name" data-field="startStation"></div>
            </div>
            <div class="route-arrow">→</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name" data-field="endStation"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">🕑</span>
                <span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">📍</span>
                <span><span class="detail-label">Distance:</span> <span data-field="distance"></span> km</span>
            </div>
            <div class="detail-item">
                <span class="season-badge">Best in <span data-field="bestSeason"></span></span>
            </div>
        </div>

        <div class="route-description" data-field="description"></div>
        <div class="highlights"><div class="highlights-list"></div></div>
        <div class="route-actions">
            <a class="view-details-btn">View Details &amp; Book →</a>
        </div>
    </div>
</template>

<script type="module">
    const regionFilter = document.querySelector('#region-filter');
    const seasonFilter = document.querySelector('#season-filter');
    const query = new URLSearchParams(window.location.search);

    function fillFilter(select, values, selectedValue) {
        const uniqueValues = [...new Set(values)].sort();

        for (const value of uniqueValues) {
            const label = value.charAt(0).toUpperCase() + value.slice(1);
            select.add(new Option(label, value));
        }

        if (uniqueValues.includes(selectedValue)) {
            select.value = selectedValue;
        }
    }

    const grid = document.querySelector('#trip-list');
    const template = document.querySelector('#trip-card-template');
    const status = document.querySelector('#trip-status');

    function createTripCard(trip) {
        const card = template.content.firstElementChild.cloneNode(true);

        for (const field of card.querySelectorAll('[data-field]')) {
            field.textContent = trip[field.dataset.field];
        }

        card.classList.add(trip.region);
        card.querySelector('.season-badge').classList.add(`season-${trip.bestSeason}`);
        card.querySelector('a').href = `/trips/${encodeURIComponent(trip.id)}`;

        const highlights = card.querySelector('.highlights-list');
        for (const highlight of trip.highlights ?? []) {
            const tag = document.createElement('span');
            tag.className = 'highlight-tag';
            tag.textContent = highlight;
            highlights.append(tag);
        }

        return card;
    }

    async function loadTrips() {
        const response = await fetch('/api/trips');

        if (!response.ok) {
            throw new Error(`Failed to load trips (${response.status})`);
        }

        const trips = await response.json();

        fillFilter(regionFilter, trips.map(trip => trip.region), query.get('region'));
        fillFilter(seasonFilter, trips.map(trip => trip.bestSeason), query.get('season'));

        function renderTrips() {
            const visibleTrips = trips.filter(trip =>
                (regionFilter.value === 'all' || trip.region === regionFilter.value) &&
                (seasonFilter.value === 'all' || trip.bestSeason === seasonFilter.value)
            );

            grid.replaceChildren(...visibleTrips.map(createTripCard));
            status.hidden = visibleTrips.length > 0;
            status.textContent = trips.length === 0
                ? 'No trips available.'
                : 'No trips match these filters.';
        }

        regionFilter.addEventListener('change', renderTrips);
        seasonFilter.addEventListener('change', renderTrips);
        renderTrips();
    }

    loadTrips().catch(error => {
        console.error(error);
        status.hidden = false;
        status.textContent = 'Unable to load trips. Please refresh to try again.';
    });
</script>

<%- include('../partials/footer') %>